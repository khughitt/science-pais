digraph t023_v2 {
  rankdir=LR;
  node [fontname="Helvetica",fontsize=10];
  edge [color="#555555"];

  // treatment / outcome
  "menopausal_transition" [label="Menopausal\ntransition",fillcolor="#1f77b4",fontcolor=white,style="filled,bold",shape=box];
  "pais_outcome" [label="PAIS\noutcome",fillcolor="#d62728",fontcolor=white,style="filled,bold",shape=box];

  // primary measured confounders (adjust) — yellow
  "age" [label="Age",fillcolor="#ffe08a",style=filled,shape=box];
  "smoking" [label="Smoking",fillcolor="#ffe08a",style=filled,shape=box];
  "sex_birth" [label="Sex at birth\n(restrict)",fillcolor="#ffe08a",style=filled,shape=box];

  // sensitivity / demoted confounders (confounder-by-structure, not primary) — orange
  "baseline_comorbidity" [label="Baseline\ncomorbidity",fillcolor="#ffd1a3",style=filled];
  "baseline_bmi" [label="Baseline BMI",fillcolor="#ffd1a3",style=filled];
  "parity" [label="Parity /\npregnancy hx",fillcolor="#ffd1a3",style=filled];
  "autoimmune_poi" [label="Autoimmune\nPOI",fillcolor="#ffd1a3",style=filled];
  "frailty" [label="Biological\nfrailty",fillcolor="#ffd1a3",style=filled];
  "era" [label="Calendar /\nvariant era",fillcolor="#ffd1a3",style=filled];

  // mediators (do-not-adjust for total effect) — green
  "sex_hormones" [label="Sex hormones",fillcolor="#c7e9c0",style=filled];
  "hormone_therapy" [label="Hormone therapy",fillcolor="#c7e9c0",style=filled];
  "incident_comorbidity" [label="Incident\ncomorbidity",fillcolor="#c7e9c0",style=filled];
  "incident_adiposity" [label="Incident visceral\nadiposity",fillcolor="#c7e9c0",style=filled];
  "immune_dys" [label="Immune\ndysregulation",fillcolor="#c7e9c0",style=filled];
  "thromboinflammation" [label="Thrombo-\ninflammation",fillcolor="#c7e9c0",style=filled];
  "acute_severity" [label="Acute\nseverity",fillcolor="#c7e9c0",style=filled];

  // ascertainment / measurement — grey note
  "symptom_overlap" [label="Symptom\noverlap",fillcolor="#e0e0e0",style=filled,shape=note];

  // colliders / selection (do-not-condition) — purple hexagon
  "clinic" [label="Clinic\nattendance",fillcolor="#cbb3e6",style="filled,bold",shape=hexagon];
  "hospital_ascert" [label="Hospitalization /\nascertainment",fillcolor="#cbb3e6",style="filled,bold",shape=hexagon];
  "survival_selection" [label="Survival\nselection",fillcolor="#cbb3e6",style="filled,bold",shape=hexagon];

  // latent — dashed ellipse
  "U" [label="Unmeasured\nconfounders (U)",fillcolor=white,style="filled,dashed",shape=ellipse];

  // --- age ---
  "age" -> "menopausal_transition" ;
  "age" -> "baseline_comorbidity" ;
  "age" -> "incident_comorbidity" ;
  "age" -> "immune_dys" ;
  "age" -> "acute_severity" ;
  "age" -> "pais_outcome" ;
  "age" -> "survival_selection" ;
  // --- smoking ---
  "smoking" -> "menopausal_transition" ;
  "smoking" -> "baseline_comorbidity" ;
  "smoking" -> "acute_severity" ;
  "smoking" -> "pais_outcome" ;
  "smoking" -> "survival_selection" ;
  // --- sex at birth ---
  "sex_birth" -> "menopausal_transition" ;
  "sex_birth" -> "sex_hormones" ;
  "sex_birth" -> "immune_dys" ;
  "sex_birth" -> "pais_outcome" ;
  // --- baseline comorbidity (confounder; KEY new edge) ---
  "baseline_comorbidity" -> "menopausal_transition" [color="#aa0000",penwidth=1.6] ;
  "baseline_comorbidity" -> "acute_severity" ;
  "baseline_comorbidity" -> "pais_outcome" ;
  "baseline_comorbidity" -> "incident_comorbidity" ;
  // --- baseline BMI (confounder; time-split) ---
  "baseline_bmi" -> "menopausal_transition" ;
  "baseline_bmi" -> "baseline_comorbidity" ;
  "baseline_bmi" -> "pais_outcome" ;
  // --- parity ---
  "parity" -> "menopausal_transition" ;
  "parity" -> "sex_hormones" ;
  "parity" -> "immune_dys" ;
  // --- autoimmune POI ---
  "autoimmune_poi" -> "menopausal_transition" ;
  "autoimmune_poi" -> "pais_outcome" ;
  "autoimmune_poi" -> "immune_dys" ;
  // --- frailty ---
  "frailty" -> "menopausal_transition" ;
  "frailty" -> "pais_outcome" ;
  "frailty" -> "survival_selection" ;
  // --- era ---
  "era" -> "acute_severity" ;
  "era" -> "pais_outcome" ;
  // --- treatment -> mediators ---
  "menopausal_transition" -> "sex_hormones" ;
  "menopausal_transition" -> "hormone_therapy" ;
  "menopausal_transition" -> "symptom_overlap" ;
  "menopausal_transition" -> "incident_adiposity" ;
  // --- sex hormones ---
  "sex_hormones" -> "immune_dys" ;
  "sex_hormones" -> "thromboinflammation" ;
  "sex_hormones" -> "incident_comorbidity" ;
  "sex_hormones" -> "incident_adiposity" ;
  "hormone_therapy" -> "sex_hormones" ;
  "symptom_overlap" -> "hormone_therapy" ;
  // --- incident adiposity ---
  "incident_adiposity" -> "immune_dys" ;
  "incident_adiposity" -> "incident_comorbidity" ;
  // --- incident comorbidity ---
  "incident_comorbidity" -> "thromboinflammation" ;
  "incident_comorbidity" -> "pais_outcome" ;
  // --- immune / thrombo / severity ---
  "immune_dys" -> "acute_severity" ;
  "immune_dys" -> "pais_outcome" ;
  "acute_severity" -> "thromboinflammation" ;
  "acute_severity" -> "pais_outcome" ;
  "thromboinflammation" -> "pais_outcome" ;
  // --- colliders ---
  "symptom_overlap" -> "clinic" ;
  "pais_outcome" -> "clinic" ;
  "acute_severity" -> "hospital_ascert" ;
  "pais_outcome" -> "hospital_ascert" ;
  // --- latent U ---
  "U" -> "menopausal_transition" [style=dashed,color="#aa0000"];
  "U" -> "pais_outcome" [style=dashed,color="#aa0000"];

  label="t023 DAG v2: total effect of menopausal transition on PAIS (sketch)\nblue=treatment red=outcome yellow=primary confounder(adjust: age,smoking) orange=confounder demoted to sensitivity\ngreen=mediator(do-not-adjust) purple=collider/selection(do-not-condition) grey=ascertainment dashed=latent\nU latent => total effect NOT identifiable by adjustment; red edge = new baseline-comorbidity->menopause";
  labelloc=b; fontsize=9;
}
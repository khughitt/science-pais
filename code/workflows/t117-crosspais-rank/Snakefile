# --- WP1b tranche (a): series-matrix group metadata for RNA-seq deposits ------
# The case/control label of several RNA-seq deposits lives in the series-matrix header
# (not the expr columns). parse_geo_metadata parses the STAGED, hash-verified
# series_matrix payload (header-only; RNA-seq series matrices carry an empty value
# table) into a tidy samples sheet; stage_matrix's `sheet` group_source joins it to the
# expr columns and applies the deposit's level_map / group_regex (raw condition -> arm).
rule parse_geo_metadata:
    input:
        staged=f"{RAW}/{{accession}}/staged.ok",
        blob=lambda wc: f"{RAW}/{wc.accession}/{config['parse'][wc.accession]['metadata_payload']}.data",
        script=f"{SCRIPTS}/parse_geo_metadata.py",
    output:
        samples=f"{PROC}/{{accession}}/series_metadata.samples.tsv",
    wildcard_constraints:
        accession="|".join(SERIES_META_ACCESSIONS) if SERIES_META_ACCESSIONS else "^$",
    log:
        f"{RES}/logs/metadata/parse_geo_metadata.{{accession}}.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --in {input.blob} --out-samples {output.samples} > {log} 2>&1"

# --- WP1b tranche (a2): family-SOFT group metadata for `tar` deposits ---------
# Sibling of parse_geo_metadata for deposits whose group lives ONLY in the family SOFT
# (multi-platform deposits whose plain series-matrix URL 404s, or SOFT-only strata like
# the GSE130353 monocyte QFS/QS arms). parse_geo_soft parses the STAGED, hash-verified
# soft payload into soft_metadata.samples.tsv; stage_matrix's `sheet` group_source joins
# it (by the GSM the tar member filename carries) and applies the deposit's group_regex.
rule parse_geo_soft:
    input:
        staged=f"{RAW}/{{accession}}/staged.ok",
        blob=lambda wc: f"{RAW}/{wc.accession}/{config['parse'][wc.accession]['metadata_payload']}.data",
        script=f"{SCRIPTS}/parse_geo_soft.py",
    output:
        samples=f"{PROC}/{{accession}}/soft_metadata.samples.tsv",
    wildcard_constraints:
        accession="|".join(SOFT_META_ACCESSIONS) if SOFT_META_ACCESSIONS else "^$",
    log:
        f"{RES}/logs/metadata/parse_geo_soft.{{accession}}.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --in {input.blob} --out-samples {output.samples} > {log} 2>&1"

# --- WP1b: per-deposit parse of the verified raw payload → uniform gene matrix -
# Acquisition (above) is COMPLETE. `stage_matrix.py` turns each heterogeneous raw
# payload (counts csv/tsv, RAW.tar of per-sample files, microarray series-matrix /
# SOFT) into the BRUTALLY UNIFORM expr + sample-sheet + QA contract, driven ENTIRELY
# by the deposit's `parse:` block in config (ingest contract) + its `de_models` entry
# (the covariate columns the sheet must carry). It reads `<payload>.origin.json` for
# provenance and dispatches by the declared `handler`. Deferred deposits HALT naming
# their exact blocker (metadata payload / harmonization map) — never a fabricated
# label. The extra `stage_matrix.qa.json` is the executable per-deposit ingest
# contract (review Finding F). The salmon accession is served by salmon_gene_matrix.
rule stage_matrix:
    input:
        staged=f"{RAW}/{{accession}}/staged.ok",
        script=f"{SCRIPTS}/stage_matrix.py",
        srclib=ancient(f"{SCRIPTS}/acquire_common.py"),
        gene_map=stage_map_input,   # only for non-Ensembl deposits (else [])
        prebuilt=prebuilt_input,    # only for prebuilt (microarray) deposits (else [])
        metadata=metadata_sheet_input,  # only for matrix deposits with series-matrix group metadata (else [])
        config=CONFIGFILE,
    output:
        expr=f"{PROC}/{{accession}}/expr.gene.tsv.gz",
        sheet=f"{PROC}/{{accession}}/sample_sheet.tsv",
        qa_json=f"{PROC}/{{accession}}/stage_matrix.qa.json",
        qa=f"{PROC}/{{accession}}/clean.qa.pass",
    wildcard_constraints:
        accession="|".join(GEO_ACCESSIONS),
    log:
        f"{RES}/logs/stage_matrix/{{accession}}.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --config {input.config} --accession {wildcards.accession} "
        "--out-expr {output.expr} --out-sheet {output.sheet} --out-qa {output.qa_json} "
        "--qa-pass {output.qa} > {log} 2>&1"

# --- WP1b: cross-deposit QA reconciliation (standalone review target) ----------
# Rolls every ready deposit's per-deposit stage_matrix.qa.json up into ONE sheet so the
# heterogeneity that matters BEFORE the rank step — mixed expression scales, mixed gene-id
# namespaces, arm balance, covariate coverage — is reviewable at a glance. NOT in `rule
# all` (it is a QA artifact, not a pipeline dependency); run it explicitly:
#     uv run --frozen snakemake -s code/workflows/t117-crosspais-rank/Snakefile reconcile_qa
# It depends on each deposit's qa.json, which stage_matrix emits only on a PASS — so a
# deposit that fails its ingest contract blocks the reconciliation (no silent gap).
rule reconcile_qa:
    input:
        qa=[f"{PROC}/{acc}/stage_matrix.qa.json" for acc in STAGE_MATRIX_ACCESSIONS],
        script=f"{SCRIPTS}/reconcile_qa.py",
    output:
        tsv=f"{RES}/reconciliation/stage_matrix.reconciliation.tsv",
        summary=f"{RES}/reconciliation/stage_matrix.reconciliation.json",
    log:
        f"{RES}/logs/reconcile_qa.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --qa {input.qa} --out-tsv {output.tsv} "
        "--out-json {output.summary} > {log} 2>&1"

# =============================================================================
# WP2 — uniform DE -> enrichment over the ONE pinned universe. fgsea_enrich.R is
# reused verbatim; limma_de.R is reused only for `~ group` contrasts (see the
# de_models contract — `stock_ok: false` contrasts need a WP2 model extension).
# Expression is never merged across datasets; every contrast meets only at the
# NES level.
# =============================================================================
rule limma_de:
    # WP2: SCALE-AWARE moderated-t via de_ranklist.R (t117-owned; NOT the stock t035
    # limma_de.R, which lmFits DIRECTLY and only fits `~ group` — correct only for
    # already-log data). de_ranklist voom-normalizes counts/estimated_counts, log2s
    # fpkm/cpm, and lmFits already-log scales directly, so EVERY contrast yields the
    # SAME ranking statistic (moderated-t) and the NES vectors stay commensurable.
    # It also applies the per-contrast `de_models` extensions declared in config:
    # `collapse_to` (longitudinal one-contrast-per-subject), `design_covariates`
    # (e.g. platform batch), and `block` (twin-pair duplicateCorrelation) — so the
    # divergence from `~ group` is deliberate, driven by config, never a silent fallback.
    input:
        unpack(acc_of),
        script=f"{SCRIPTS}/de_ranklist.R",
    output:
        ranked=f"{PROC}/de/{{contrast}}.ranked.tsv",
        diag=f"{PROC}/de/{{contrast}}.diag.json",
    params:
        seed=config["determinism"]["master_seed"],
        scale=lambda wc: config["parse"].get(ACC_OF[wc.contrast], {}).get("expression_scale", "NONE"),
        collapse=lambda wc: de_model_of(wc).get("collapse_to", "NONE"),
        covs=lambda wc: ",".join(de_model_of(wc).get("design_covariates", [])) or "NONE",
        block=lambda wc: de_model_of(wc).get("block", "NONE"),
    log:
        f"{RES}/logs/de/{{contrast}}.log",
    conda:
        "../envs/r-bioc.yaml"
    shell:
        "Rscript {input.script} --dataset {wildcards.contrast} --contrast {wildcards.contrast} "
        "--expr {input.expr} --sheet {input.sheet} --scale {params.scale} "
        "--collapse-col {params.collapse} --design-covariates {params.covs} --block {params.block} "
        "--seed {params.seed} --out-ranked {output.ranked} --out-diag {output.diag} > {log} 2>&1"

rule fgsea_enrich:
    input:
        ranked=f"{PROC}/de/{{contrast}}.ranked.tsv",
        universe=UNIVERSE_RDS,
        universe_qa=f"{PROC}/genesets/universe.qa.pass",
        script=f"{SCRIPTS}/fgsea_enrich.R",
    output:
        nes=f"{PROC}/fgsea/{{contrast}}.nes.tsv",
    params:
        db="+".join(config["genesets"]["composition"]),   # single combined universe (hallmark+reactome)
        min_size=config["genesets"]["size_filter"]["min"],
        max_size=config["genesets"]["size_filter"]["max"],
        seed=config["determinism"]["master_seed"],
    log:
        f"{RES}/logs/fgsea/{{contrast}}.log",
    conda:
        "../envs/r-bioc.yaml"
    shell:
        "Rscript {input.script} --db {params.db} --contrast {wildcards.contrast} "
        "--ranked {input.ranked} --geneset {input.universe} "
        "--min-size {params.min_size} --max-size {params.max_size} "
        "--seed {params.seed} --out-nes {output.nes} > {log} 2>&1"

rule assemble_matrix:
    # WP2: pivot the BUILDABLE columns' NES vectors into ONE pathway x contrast
    # matrix + grouping metadata. assemble_matrix.py reconstructs the rank matrix's
    # columns from config (single source), records DEFERRED columns explicitly as
    # omitted_columns (never a silent drop), and runs the same-tissue LC RNA-seq
    # NES-comparability check (WP2 DoD). Expression never merges across datasets —
    # deposits meet only here, at the NES level.
    input:
        nes=matrix_nes,
        config=CONFIGFILE,
        script=f"{SCRIPTS}/assemble_matrix.py",
    output:
        matrix=f"{PROC}/matrix/{{matrix}}.pathway_by_contrast.tsv",
        grouping=f"{PROC}/matrix/{{matrix}}.grouping.json",   # condition/platform/compartment + omitted + comparability
    log:
        f"{RES}/logs/assemble_matrix/{{matrix}}.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --config {input.config} --matrix {wildcards.matrix} "
        "--proc {PROC} --out-matrix {output.matrix} --out-grouping {output.grouping} > {log} 2>&1"

# =============================================================================
# WP3 — rank battery + t116 structural co-primary + LODO/LOCO (Finding A), and
# the Stage-3c calibration against t116's generative model (Finding B). The
# calibration sentinel GATES grid placement (Stage 5).
# =============================================================================
rule rank_battery:
    # WP3: rotation-invariant rank battery (parallel analysis + bi-cross-validation SVD
    # + split-half) with a row-bootstrap CI, the t116 structural co-primary (off-diagonal
    # concordance SD), and pre-locked LODO/LOCO + first-class LC-out power/CI curve +
    # compartment-stratified R. All estimators live in rank_estimators.py — the SAME
    # module calibration_3c imports (Finding B: calibrated == applied procedure).
    input:
        matrix=f"{PROC}/matrix/{{matrix}}.pathway_by_contrast.tsv",
        grouping=f"{PROC}/matrix/{{matrix}}.grouping.json",
        script=f"{SCRIPTS}/rank_battery.py",
        estimators=f"{SCRIPTS}/rank_estimators.py",
        config=CONFIGFILE,
    output:
        rank=f"{RES}/rank/{{matrix}}.rank.json",          # R + CI from >=3 estimators
        structural=f"{RES}/rank/{{matrix}}.structural.json",  # off-diagonal concordance SD
        stability=f"{RES}/rank/{{matrix}}.stability.json",    # LODO + LOCO + LC-out power curve
    log:
        f"{RES}/logs/rank/{{matrix}}.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --config {input.config} --matrix {wildcards.matrix} "
        "--in-matrix {input.matrix} --in-grouping {input.grouping} "
        "--out-rank {output.rank} --out-structural {output.structural} "
        "--out-stability {output.stability} > {log} 2>&1"

rule calibration_3c:
    # review Finding B: calibration MUST be against the OBSERVED corpus — the
    # synthetic matrices are injected at the real matrix's K/N (from grouping) and
    # matched to its off-diagonal concordance (from structural). Depending on these
    # inputs makes it impossible to "pass" calibration independent of the matrix and
    # still unlock the grid. Uses the strict matrix as the reference geometry.
    input:
        matrix=f"{PROC}/matrix/strict.pathway_by_contrast.tsv",
        grouping=f"{PROC}/matrix/strict.grouping.json",       # real K (triggers) / N
        structural=f"{RES}/rank/strict.structural.json",      # real off-diagonal concordance
        script=f"{SCRIPTS}/calibration_3c.py",
        estimators=f"{SCRIPTS}/rank_estimators.py",
        config=CONFIGFILE,
    output:
        report=f"{RES}/calibration/calibration.json",
        sentinel=f"{RES}/calibration/calibration.pass",     # JSON verdict; grid_placement is fail-closed on pass==true
    log:
        f"{RES}/logs/calibration/calibration_3c.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --config {input.config} --in-matrix {input.matrix} "
        "--in-grouping {input.grouping} --in-structural {input.structural} "
        "--out-report {output.report} --out-sentinel {output.sentinel} > {log} 2>&1"

# =============================================================================
# WP4 — artifact + compartment adjudication (Finding C). Named rivals: correlated
# shared artifact (t116) and cell-composition-shift axis.
# =============================================================================
rule artifact_adjudication:
    input:
        rank=f"{RES}/rank/{{matrix}}.rank.json",
        structural=f"{RES}/rank/{{matrix}}.structural.json",
        matrix=f"{PROC}/matrix/{{matrix}}.pathway_by_contrast.tsv",
        extra_nes=adjudication_extra_nes,   # sorted stratum + acute decoys (strict only; Finding C)
    output:
        adjudicated=f"{RES}/artifact/{{matrix}}.adjudicated.json",  # artifact- & composition-adjusted R
        # Finding C, explicit: R estimated WITHIN each deconvolvable compartment
        # stratum (WB, PBMC) + the drop-sorted sensitivity + composition-adjusted
        # R. The sorted stratum is a SINGLE column (QFS) → it has NO own rank; it
        # enters only as a held-out compartment for the drop-sorted comparison and
        # as a projection target, never as its own rank matrix.
        stratified=f"{RES}/artifact/{{matrix}}.compartment_stratified.json",
    params:
        controls=config["artifact_controls"],
    shell:
        stub("artifact_adjudication {wildcards.matrix}")


    input:
        raw=f"{RAW}/GSE14577/staged.ok",
        blob=f"{RAW}/GSE14577/soft.data",
        script=f"{SCRIPTS}/parse_gse14577.py",
    output:
        gpl96=f"{PROC}/GSE14577/expr_GPL96.probe_x_sample.tsv.gz",
        gpl97=f"{PROC}/GSE14577/expr_GPL97.probe_x_sample.tsv.gz",
        meta=f"{PROC}/GSE14577/sample_metadata.tsv",
    log:
        f"{RES}/logs/microarray/parse_gse14577.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --soft {input.blob} --out-dir {PROC}/GSE14577 > {log} 2>&1"

rule harmonize_gse14577:
    input:
        gpl96=f"{PROC}/GSE14577/expr_GPL96.probe_x_sample.tsv.gz",
        gpl97=f"{PROC}/GSE14577/expr_GPL97.probe_x_sample.tsv.gz",
        meta=f"{PROC}/GSE14577/sample_metadata.tsv",
        reference=MICRO.get("reference_json", f"{PROC}/genesets/harmonize_reference.json"),
        script=f"{SCRIPTS}/harmonize_gse14577.R",
    output:
        harmonized=f"{PROC}/GSE14577/microarray.harmonized.tsv.gz",
        sentinel=f"{PROC}/GSE14577/microarray.harmonize.qa.pass",
        report=f"{PROC}/GSE14577/microarray.harmonize_report.json",
    params:
        multimap=MICRO.get("multimap_policy", "first"),
        coverage_warn=MICRO.get("coverage_warn", 0.30),
    log:
        f"{RES}/logs/microarray/harmonize_gse14577.log",
    conda:
        "../envs/r-bioc.yaml"
    shell:
        "Rscript {input.script} --gpl96 {input.gpl96} --gpl97 {input.gpl97} "
        "--meta {input.meta} --reference {input.reference} --multimap {params.multimap} "
        "--coverage-warn {params.coverage_warn} --out-harmonized {output.harmonized} "
        "--sentinel {output.sentinel} --out-report {output.report} > {log} 2>&1"


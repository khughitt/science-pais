# =============================================================================
# Snakefile — cross-PAIS pathway-response effective-rank estimation (task:t117)
#
# Thin orchestrator: reads config.yaml (ALL design parameters) and wires the full
# DAG. Nothing is hard-coded here; rules read config. Reuses `fgsea_enrich.R`
# verbatim; `limma_de.R` is reused ONLY for the two-arm (`~ group`) contrasts —
# platform-batch / twin-paired / longitudinal / severity-axis contrasts need a WP2
# model extension (see the `de_models` contract in config). Uses the shared conda
# envs at code/workflows/envs/ (referenced via ../envs/*.yaml).
#
# Design:  entities/plans/0010-crosspais-pathway-response-rank-estimation.md
# Review:  doc/reviews/0010-crosspais-pathway-response-rank-estimation-pipeline-review.md
# Grounds: interpretation:0037-t116-power-bias-floor-shared-axis-sim
#
# WP0 status: SKELETON. Rule I/O is fully wired so `snakemake -n` resolves the
# complete DAG (acquire -> results/grid + datapackage). Rule bodies are stubs that
# exit 1 (fail-early; no silent placeholder outputs) until their work package
# implements them:
#   WP1 acquire_*/stage_matrix/verify_universe   (staging)
#   WP2 limma_de/fgsea_enrich/assemble_matrix     (uniform DE -> enrichment)
#   WP3 rank_battery + calibration_3c             (rank + t116 calibration; Findings A,B)
#   WP4 artifact_adjudication                     (artifact + compartment; Finding C)
#   WP4b gws_fm_specificity                       (non-infectious read-across; Finding D)
#   WP6 grid_placement + datapackage              (t116 grid, gated on 3c)
#
# Run (dry-run resolves the DAG without staged data):
#     uv run --frozen snakemake -s code/workflows/t117-crosspais-rank/Snakefile -n all
# =============================================================================
from pathlib import Path

# --- invocation contract (invocation-independent, matches t116 sibling) ------
SNAKEFILE_DIR = Path(workflow.basedir).resolve()
REPO_ROOT = SNAKEFILE_DIR.parent.parent.parent   # t117-crosspais-rank -> workflows -> code -> root
SCRIPTS = str(REPO_ROOT / "code" / "scripts")    # reuse plan:0003 R/py scripts
CONFIGFILE = str(SNAKEFILE_DIR / "config.yaml")
configfile: CONFIGFILE
workdir: str(REPO_ROOT)

RAW = config["paths"]["raw"]
PROC = config["paths"]["processed"]
RES = config["paths"]["results"]

# --- config-derived enumerations (single source: config.yaml) ----------------
CONTRASTS = list(config["contrasts"].keys())
ACC_OF = {c: config["contrasts"][c]["accession"] for c in CONTRASTS}
ACCESSIONS = sorted(set(ACC_OF.values()))
RANK_MATRICES = ["strict", "sensitivity"]        # matrices a rank is estimated on
UNIVERSE_RDS = config["genesets"]["universe_rds"]

# Two-matrix design (plan:0010 "strict matrix PLUS probable-PI ME/CFS"): the
# sensitivity rank matrix is NESTED — the strict columns PLUS the ME/CFS
# additions, NOT an ME/CFS-only matrix. Membership tags in config are composed
# here so the nesting is explicit, not implied by a name.
MATRIX_COMPOSITION = {
    "strict": ("strict",),
    "sensitivity": ("strict", "sensitivity"),   # nested: strict + ME/CFS additions
}

def tagged(tag):
    """Contrasts carrying a given membership tag (strict|sensitivity|stratum|decoy)."""
    return [c for c in CONTRASTS if config["contrasts"][c]["matrix"] == tag]

def matrix_columns(matrix):
    """Contrast columns composing a rank matrix, honoring the nested two-matrix
    design (sensitivity = strict + sensitivity additions)."""
    tags = MATRIX_COMPOSITION[matrix]
    return [c for c in CONTRASTS if config["contrasts"][c]["matrix"] in tags]

def is_buildable(contrast):
    """A contrast column is buildable NOW iff its accession produced the uniform
    expr contract (stage_matrix PASS) — i.e. its parse block is not `deferred`.
    The salmon decoy is buildable only once its run subset is resolved (WP1b d).
    Deferred columns (gse267625, gse143549) are NOT dropped silently: they are
    recorded in the matrix grouping as `omitted_columns` with their blocker."""
    acc = ACC_OF[contrast]
    if config["contrasts"][contrast].get("quantify") == "salmon":
        return bool(config["salmon"]["runs"].get(acc, {}).get("accessions"))
    return acc in STAGE_MATRIX_ACCESSIONS

def matrix_nes(wildcards):
    """NES tables for every BUILDABLE contrast column of the requested rank matrix.
    Deferred columns are excluded here (no producer yet) and surfaced explicitly by
    assemble_matrix as omitted_columns — never a silent gap (plan:0010 discipline)."""
    return [f"{PROC}/fgsea/{c}.nes.tsv"
            for c in matrix_columns(wildcards.matrix) if is_buildable(c)]

def adjudication_extra_nes(wildcards):
    """Extra columns the strict-matrix adjudication consumes but the rank matrix
    does NOT pool (review Finding C): the sorted-compartment stratum (QFS) for
    compartment-stratified R, and the acute-infection decoys for the specificity
    layer. Sensitivity-matrix adjudication pulls no extras."""
    if wildcards.matrix != "strict":
        return []
    extra = tagged("stratum") + tagged("decoy")
    return [f"{PROC}/fgsea/{c}.nes.tsv" for c in extra]

def de_model_of(wildcards):
    """Per-contrast DE model spec (config `de_models`; falls back to `default`).
    Carries the design/block/coef and `stock_ok` — whether the plan:0003
    limma_de.R suffices as-is or WP2 must extend it (review Finding, model
    contract). limma_de is a STUB in WP0; this threads the contract through now."""
    return config["de_models"].get(wildcards.contrast, config["de_models"]["default"])

def acc_of(wildcards):
    """Staged expr + sheet for the accession owning a contrast."""
    acc = ACC_OF[wildcards.contrast]
    return {
        "expr": f"{PROC}/{acc}/expr.gene.tsv.gz",
        "sheet": f"{PROC}/{acc}/sample_sheet.tsv",
        "qa": f"{PROC}/{acc}/clean.qa.pass",
    }

def stub(label):
    """WP0 skeleton rule body: fail loudly on a real run (no silent placeholder
    output); `snakemake -n` still resolves the DAG. Replaced per work package."""
    return (f"echo 'STUB {label} — not yet implemented (WP0 skeleton; "
            f"plan:0010). Implement in its work package before running.' >&2; exit 1")

# --- WP1 acquisition (config-driven; single source is config["acquisition"]) --
ACQ = config.get("acquisition", {})
GEO_ACCESSIONS = sorted(ACQ.keys())          # deposits staged by download + verify
SALMON_ACCESSIONS = sorted({ACC_OF[c] for c in CONTRASTS
                            if config["contrasts"][c].get("quantify") == "salmon"})
SALMON_RE = "|".join(SALMON_ACCESSIONS) if SALMON_ACCESSIONS else "^$"   # never-match if none
REF = config["salmon"]["transcriptome"]["name"]   # e.g. gencode.v44.transcripts

def payloads_of(acc):
    """Named raw payloads to stage for a GEO/FigShare deposit (config)."""
    return list(ACQ[acc]["payloads"].keys())

def payload_spec(acc, pay):
    return ACQ[acc]["payloads"][pay]

def deposit_payload_blobs(wildcards):
    """Every verified payload blob a deposit's staged.ok aggregates."""
    acc = wildcards.accession
    return [f"{RAW}/{acc}/{pay}.data" for pay in payloads_of(acc)]

# --- WP1b (b): shared gene-id harmonization map (org.Hs.eg.db, pinned) --------
HARM = config.get("harmonization", {})
HMAP_TSV = HARM.get("map_tsv")
MAP_NAMESPACES = {"symbol", "alias", "refseq"}

def stage_map_input(wildcards):
    """The harmonization map is a stage_matrix input ONLY for deposits declaring a
    non-Ensembl gene-id namespace (Ensembl deposits don't need it, so they don't
    force the r-bioc build)."""
    ns = config.get("parse", {}).get(wildcards.accession, {}).get("gene_id_namespace")
    return [HMAP_TSV] if ns in MAP_NAMESPACES and HMAP_TSV else []

def prebuilt_input(wildcards):
    """For a `prebuilt` deposit, the upstream microarray chain's gene matrix (+ its
    samples sheet when group comes from a `sheet`). stage_matrix ADOPTS these into the
    uniform contract; other handlers get []."""
    acc = wildcards.accession
    p = config.get("parse", {}).get(acc, {})
    if p.get("handler") != "prebuilt":
        return []
    ins = [f"{PROC}/{acc}/{p['prebuilt_expr']}"]
    gs = p.get("group_source", {})
    if gs.get("mode") == "sheet":
        ins.append(f"{PROC}/{acc}/{gs['file']}")
    return ins

# --- WP1b (a): RNA-seq deposits whose case/control label lives in the series-matrix
# metadata (not the expr columns). parse_geo_metadata parses the staged series_matrix
# payload into series_metadata.samples.tsv; stage_matrix's `sheet` group_source joins it
# to the expr columns. Distinct from the microarray `prebuilt` chain (those produce a
# gene matrix; these only supply group metadata for a `matrix`-handler deposit).
# A deposit supplies group metadata via an external payload (series-matrix or family
# SOFT) parsed into a tidy samples sheet + joined by `sheet` group_source. The
# metadata_format selects the parser (series_matrix -> parse_geo_metadata; soft ->
# parse_geo_soft). This is independent of the expr handler: a `matrix` deposit (expr in
# the payload) and a `tar` deposit (expr split across tar members) both reach group the
# same way. The `prebuilt` microarray chain builds its own sheet (no metadata_payload).
def _meta_accessions(fmt):
    return sorted(
        acc for acc, p in config.get("parse", {}).items()
        if p.get("metadata_payload")
        and p.get("group_source", {}).get("mode") == "sheet"
        and p.get("metadata_format", "series_matrix") == fmt
    )

SERIES_META_ACCESSIONS = _meta_accessions("series_matrix")
SOFT_META_ACCESSIONS = _meta_accessions("soft")

# Deposits that stage_matrix turns into the uniform contract AND are ready now (not
# `status: deferred`, and a stage_matrix handler — the salmon decoy is served by
# salmon_gene_matrix instead). These are the rows the QA reconciliation rolls up.
STAGE_MATRIX_ACCESSIONS = sorted(
    acc for acc, p in config.get("parse", {}).items()
    if p.get("status") != "deferred" and p.get("handler") in {"matrix", "tar", "prebuilt"}
)

def metadata_sheet_input(wildcards):
    """For a deposit whose group comes from an external metadata payload parsed into a
    samples sheet, that sheet (so Snakemake builds it before stage_matrix). Deposits
    that carry group elsewhere (prebuilt chain, in-column regex): []."""
    acc = wildcards.accession
    p = config.get("parse", {}).get(acc, {})
    gs = p.get("group_source", {})
    if p.get("metadata_payload") and gs.get("mode") == "sheet":
        return [f"{PROC}/{acc}/{gs['file']}"]
    return []

def salmon_run_quants(wildcards):
    """Per-run salmon quant.sf for a salmon accession (empty until WP1b resolves
    the run subset — the path stays wired so the DAG resolves)."""
    acc = wildcards.accession
    return [f"{PROC}/salmon/{acc}/{run}/quant.sf"
            for run in config["salmon"]["runs"].get(acc, {}).get("accessions", [])]

wildcard_constraints:
    contrast="|".join(CONTRASTS),
    accession="|".join(ACCESSIONS),
    matrix="|".join(RANK_MATRICES),
    payload="[a-z_]+",
    run="SRR[0-9]+",

# --- terminal target ---------------------------------------------------------
rule all:
    input:
        expand(f"{RES}/grid/{{matrix}}.grid.json", matrix=RANK_MATRICES),
        f"{RES}/calibration/calibration.pass",
        f"{RES}/specificity/gws_fm.json",
        f"{RES}/datapackage.json",

# =============================================================================
# WP1 — staging (pinned + checksummed). Reuses the plan:0003 fetch_url.py (download
# + verify against a LOCKED sha256; empty hash or mismatch => HALT, partial removed)
# and verify_sha256.py (re-verify an on-disk artifact). Each deposit's raw payload(s)
# are content-addressed by their locked hash; the single universe is BUILT from the
# two hash-locked clean-base .rds (combine_universe.R) and re-verified. The SRA-only
# CHIKV decoy stages via the salmon sub-path (wired; heavy steps deferred to WP1b).
# Acquisition (download + verify) is COMPLETE; per-deposit PARSE is WP1b (stage_matrix).
# =============================================================================

# --- GEO / FigShare deposits: download + verify each raw payload -------------
rule acquire_payload:
    input:
        # ancient(): payloads are content-addressed by a LOCKED sha256, so a
        # fetch_url.py edit can never change the verified bytes — don't let code
        # churn trigger a re-download (dependency still recorded for the DAG).
        script=ancient(f"{SCRIPTS}/fetch_url.py"),
        srclib=ancient(f"{SCRIPTS}/acquire_common.py"),
    output:
        blob=f"{RAW}/{{accession}}/{{payload}}.data",
    params:
        url=lambda wc: payload_spec(wc.accession, wc.payload)["url"],
        sha256=lambda wc: payload_spec(wc.accession, wc.payload)["sha256"],
    log:
        f"{RES}/logs/acquire/{{accession}}.{{payload}}.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --url '{params.url}' --sha256 {params.sha256} "
        "--out {output.blob} > {log} 2>&1"

rule acquire_deposit:
    # a deposit is 'staged' once ALL its payloads are downloaded + hash-verified.
    input:
        deposit_payload_blobs,
    output:
        staged=f"{RAW}/{{accession}}/staged.ok",
    wildcard_constraints:
        accession="|".join(GEO_ACCESSIONS),
    params:
        payloads=lambda wc: ",".join(payloads_of(wc.accession)),
    shell:
        "printf 'staged=%s payloads=%s\\n' {wildcards.accession} '{params.payloads}' "
        "> {output.staged}"

# --- single pinned universe: BUILD from the clean base, then re-verify --------
rule build_universe:
    input:
        script=f"{SCRIPTS}/combine_universe.R",
        hallmark=config["genesets"]["source_rds"]["hallmark"]["path"],
        reactome=config["genesets"]["source_rds"]["reactome"]["path"],
    output:
        rds=UNIVERSE_RDS,
    params:
        hall_sha=config["genesets"]["source_rds"]["hallmark"]["sha256"],
        reac_sha=config["genesets"]["source_rds"]["reactome"]["sha256"],
    log:
        f"{RES}/logs/build_universe.log",
    conda:
        "../envs/r-bioc.yaml"
    shell:
        "Rscript {input.script} --in-rds {input.hallmark},{input.reactome} "
        "--dbs hallmark,reactome --sha256s {params.hall_sha},{params.reac_sha} "
        "--out-rds {output.rds} > {log} 2>&1"

rule verify_universe:
    input:
        rds=UNIVERSE_RDS,
        script=ancient(f"{SCRIPTS}/verify_sha256.py"),
        srclib=ancient(f"{SCRIPTS}/acquire_common.py"),
    output:
        qa=f"{PROC}/genesets/universe.qa.pass",
    params:
        sha=config["genesets"]["universe_sha256"],
    log:
        f"{RES}/logs/verify_universe.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --file {input.rds} --sha256 {params.sha} "
        "--sentinel {output.qa} > {log} 2>&1"

# --- shared gene-id identity map: symbol/alias/RefSeq -> Ensembl (org.Hs.eg.db) -
# Built from the SAME org.Hs.eg.db the gene sets used (pinned r-bioc env) + the same
# "first" multimap policy, so identity is commensurable by construction. Its sha256
# is pinned in config.harmonization.map_sha256 (empty => stage_matrix HALTs) and
# re-verified before any non-Ensembl deposit consumes it.
rule build_gene_id_map:
    input:
        script=f"{SCRIPTS}/build_gene_id_map.R",
    output:
        map=HMAP_TSV,
        report=HARM.get("report_json", f"{PROC}/genesets/gene_id_map.report.json"),
    params:
        keytypes=",".join(HARM.get("keytypes", ["SYMBOL", "ALIAS", "REFSEQ"])),
        multimap=HARM.get("multimap_policy", "first"),
    log:
        f"{RES}/logs/build_gene_id_map.log",
    conda:
        "../envs/r-bioc.yaml"
    shell:
        "Rscript {input.script} --keytypes {params.keytypes} --multimap {params.multimap} "
        "--out-tsv {output.map} --out-report {output.report} > {log} 2>&1"

# --- SRA-only CHIKV decoy: salmon quantification path (WIRED; run deferred) ---
# The rules resolve the full DAG; the heavy index build + FASTQ retrieval + quant
# are stubs (fail-early) and the reference hash is HALT-guarded (empty => fetch_url
# HALTs) until WP1b pins it. salmon_gene_matrix emits the SAME expr contract a GEO
# deposit does, so the decoy feeds limma_de/fgsea identically.
rule fetch_transcriptome:
    input:
        script=ancient(f"{SCRIPTS}/fetch_url.py"),
        srclib=ancient(f"{SCRIPTS}/acquire_common.py"),
    output:
        fa=f"{RAW}/salmon/{REF}.fa.gz",
    params:
        url=config["salmon"]["transcriptome"]["url"],
        sha256=config["salmon"]["transcriptome"]["sha256"],   # "" => HALT (pin in WP1b)
    log:
        f"{RES}/logs/salmon/fetch_transcriptome.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --url '{params.url}' --sha256 '{params.sha256}' "
        "--out {output.fa} > {log} 2>&1"

rule salmon_index:
    input:
        fa=f"{RAW}/salmon/{REF}.fa.gz",
    output:
        idx=directory(f"{PROC}/salmon/index/{REF}"),
    params:
        kmer=config["salmon"]["index"]["kmer"],
    conda:
        "../envs/salmon.yaml"
    shell:
        stub("salmon_index (wire-only; index build deferred to WP1b)")

rule fetch_sra_run:
    output:
        r1=f"{RAW}/salmon/{{accession}}/{{run}}_1.fastq.gz",
        r2=f"{RAW}/salmon/{{accession}}/{{run}}_2.fastq.gz",
    wildcard_constraints:
        accession=SALMON_RE,
    conda:
        "../envs/salmon.yaml"
    shell:
        stub("fetch_sra_run {wildcards.run} (prefetch + fasterq-dump; deferred to WP1b)")

rule salmon_quant:
    input:
        idx=f"{PROC}/salmon/index/{REF}",
        r1=f"{RAW}/salmon/{{accession}}/{{run}}_1.fastq.gz",
        r2=f"{RAW}/salmon/{{accession}}/{{run}}_2.fastq.gz",
    output:
        quant=f"{PROC}/salmon/{{accession}}/{{run}}/quant.sf",
    wildcard_constraints:
        accession=SALMON_RE,
    conda:
        "../envs/salmon.yaml"
    shell:
        stub("salmon_quant {wildcards.accession}/{wildcards.run} (deferred to WP1b)")

rule salmon_gene_matrix:
    # tximport per-run quant.sf → gene counts → the uniform expr contract. Run
    # subset is empty until WP1b resolves it; the rule stays wired so the DAG
    # resolves and the decoy's expr has a producer.
    input:
        idx=f"{PROC}/salmon/index/{REF}",
        quants=salmon_run_quants,
    output:
        expr=f"{PROC}/{{accession}}/expr.gene.tsv.gz",
        sheet=f"{PROC}/{{accession}}/sample_sheet.tsv",
        qa=f"{PROC}/{{accession}}/clean.qa.pass",
    wildcard_constraints:
        accession=SALMON_RE,
    conda:
        "../envs/salmon.yaml"
    shell:
        stub("salmon_gene_matrix {wildcards.accession} (tximport; deferred to WP1b)")

# --- WP1b tranche (c): microarray probe→gene chain feeding the `prebuilt` handler --
# The two microarray deposits carry their case/control grouping INLINE (series-matrix /
# SOFT header), so they PASS without an extra metadata payload. probe→Ensembl uses the
# PLATFORM annotation .db (r-bioc env), NOT the tranche-b org.Hs.eg.db symbol map. Each
# chain writes microarray.gene.tsv.gz (+ a samples sheet where group needs one) under the
# deposit's PROC dir; stage_matrix's `prebuilt` handler adopts it into the uniform contract
# (so stage_matrix stays the SOLE producer of expr.gene.tsv.gz). GSE14577 reuses the t035
# scripts verbatim; GSE16059 (GPL570) uses the generic parse_series_matrix + harmonize_microarray.
MICRO = config.get("microarray", {})

# GSE16059 (GPL570 discordant-twin ME/CFS): series-matrix → probe×sample + inline samples
rule parse_series_matrix_gse16059:
    input:
        raw=f"{RAW}/GSE16059/staged.ok",
        blob=f"{RAW}/GSE16059/series_matrix.data",
        script=f"{SCRIPTS}/parse_series_matrix.py",
    output:
        expr=f"{PROC}/GSE16059/microarray.probe_x_sample.tsv.gz",
        samples=f"{PROC}/GSE16059/microarray.samples.tsv",
    log:
        f"{RES}/logs/microarray/parse_gse16059.log",
    conda:
        "../envs/py.yaml"
    shell:
        "python {input.script} --in {input.blob} --out-expr {output.expr} "
        "--out-samples {output.samples} > {log} 2>&1"

rule harmonize_gse16059:
    input:
        probe=f"{PROC}/GSE16059/microarray.probe_x_sample.tsv.gz",
        script=f"{SCRIPTS}/harmonize_microarray.R",
    output:
        harmonized=f"{PROC}/GSE16059/microarray.harmonized.tsv.gz",
        report=f"{PROC}/GSE16059/microarray.harmonize_report.json",
    params:
        db=MICRO.get("gse16059", {}).get("platform_db", "hgu133plus2.db"),
        platform=MICRO.get("gse16059", {}).get("platform", "GPL570"),
        multimap=MICRO.get("multimap_policy", "first"),
    log:
        f"{RES}/logs/microarray/harmonize_gse16059.log",
    conda:
        "../envs/r-bioc.yaml"
    shell:
        "Rscript {input.script} --db {params.db} --platform {params.platform} "
        "--multimap {params.multimap} --probe-expr {input.probe} "
        "--out-harmonized {output.harmonized} --out-report {output.report} > {log} 2>&1"

rule collapse_gse16059:
    input:
        harmonized=f"{PROC}/GSE16059/microarray.harmonized.tsv.gz",
        script=f"{SCRIPTS}/collapse_probes.R",
    output:
        expr=f"{PROC}/GSE16059/microarray.gene.tsv.gz",
        audit=f"{PROC}/GSE16059/microarray.cohort_audit.json",
    log:
        f"{RES}/logs/microarray/collapse_gse16059.log",
    conda:
        "../envs/r-bioc.yaml"
    shell:
        "Rscript {input.script} --dataset GSE16059 --harmonized {input.harmonized} "
        "--collapse median --dual-chip mean_of_platform_collapsed_log2 "
        "--out-expr {output.expr} --out-audit {output.audit} > {log} 2>&1"

# GSE14577 (U133A∪B PI-CFS sensitivity): t035 SOFT chain reused VERBATIM

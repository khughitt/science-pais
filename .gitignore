# Secrets
.env

# Large files
papers/pdfs/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.mypy_cache/

# Notebooks
.ipynb_checkpoints/

# Worktrees
.worktrees/

# Science CLI lock files
**/.references.bib.lock
**/.tasks.lock

# Managed artifact rollback backups
*.pre-update*.bak

# OS
.DS_Store

# Research data payloads live OFF this (Dropbox) repo on the big disk:
# data/raw and data/processed are host-local symlinks to
# /data/proj/post-acute-infection/{raw,processed} (see data/README.md).
# Ignore the symlinks themselves and any payloads reachable through them.
data/raw
data/processed
results/*
!results/.gitkeep

# Snakemake run cache/logs (workflow outputs live under data/ & results/, gitignored)
.snakemake/
code/workflows/.snakemake/

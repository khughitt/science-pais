    <http://example.org/project/proposition/0006-cross-sectional-cyclops-cmag-from-a-small-30-gene-seed-is-too-seed> sci:claimLayer "empirical_regularity" ;
        sci:freshnessState "needs-review" ;
        sci:identificationStrength "observational" ;
        sci:measurementModel "{\"observed_entity\": \"CYCLOPS magnitude (CMag) from unsupervised CYCLOPS 2.0 ordering of cross-sectional TCGA-BRCA luminal-A transcriptomes, seeded from a ~30-gene curated circadian prior\", \"latent_construct\": \"tumor circadian-oscillator strength\", \"measurement_relation\": \"indirect proxy: weighted sum of inferred cycling-gene amplitudes after sample-order reconstruction from a single timepoint, no measured time-of-collection\", \"rationale\": \"CMag is the only available operationalization of per-tumor clock strength from static biopsy data, but it is recovered, not measured\", \"known_failure_modes\": [\"seed-dependence: dropping 6/30 seed genes shifts the per-tumor ranking (median Spearman 0.65, min 0.07; high-tertile kappa 0.51)\", \"a few seed genes are load-bearing (NR1D1/NR1D2/HLF), so the construct mapping is not robust\", \"pipeline/normalization divergence vs Li2024 (Xena Toil eigenspace, Flux 0.14 engine) can flip sign\", \"no time-of-collection: ordering quality depends on cohort phase coverage\"], \"substitutable_with\": []}" ;
        sci:profile "core" ;
        sci:projectStatus "active" ;
        sci:proxyDirectness "indirect" ;
        sci:scope "project" ;
        sci:supportsScope "local_proposition" ;
        sci:triggeredBy <http://example.org/project/dataset/brca-tcga-pancanatlas>,
            <http://example.org/project/evidence-line/0020-cmag-small-seed-perturbation-supports-seed-instability>,
            <http://example.org/project/interpretation/0004-cmag-prognostic-null-and-seed-unstable>,
            <http://example.org/project/source-snapshot/1991aa44dfebc406>,
            <http://example.org/project/source-snapshot/477dbad39039526a>,
            <http://example.org/project/source-snapshot/fd936b3557f771f3> ;
        sci:upstreamChangeAt "2026-07-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
        cito:discusses <http://example.org/project/hypothesis/0001-rhythms-as-homeostatic-control> ;
        a sci:Proposition ;
        skos:prefLabel "Cross-sectional CYCLOPS CMag from a small (~30-gene) seed is too seed-unstable to serve as a reliable prognostic index" ;
        skos:related <http://example.org/project/hypothesis/0001-rhythms-as-homeostatic-control>,
            <http://example.org/project/question/0077-tumor-cmag-prognostic-validation-breast-cancer> ;
        prov:wasDerivedFrom <http://example.org/project/interpretation/0004-cmag-prognostic-null-and-seed-unstable>,
            <http://example.org/project/source/entities_propositions_0006-cross-sectional-cyclops-cmag-from-a-small-30-gene-seed-is-too-seed.md> ;
        schema:identifier "proposition:0006-cross-sectional-cyclops-cmag-from-a-small-30-gene-seed-is-too-seed" .
    <http://example.org/project/proposition/0007-flat-list-cyclops-cmag-on-single-timepoint-luma-is-method-unstable> sci:claimLayer "empirical_regularity" ;
        sci:freshnessState "needs-review" ;
        sci:identificationStrength "observational" ;
        sci:measurementModel "{\"observed_entity\": \"CYCLOPS magnitude (CMag) from unsupervised CYCLOPS 2.0 ordering of cross-sectional TCGA-BRCA luminal-A transcriptomes, seeded from a flat (unweighted) circadian gene list of arbitrary size/curation\", \"latent_construct\": \"tumor circadian-oscillator strength\", \"measurement_relation\": \"indirect proxy: weighted sum of inferred cycling-gene amplitudes after sample-order reconstruction from a single timepoint, no measured time-of-collection; the seed enters only as an unweighted membership set\", \"rationale\": \"CMag is the only available operationalization of per-tumor clock strength from static biopsy data, but it is recovered, not measured, and the recovery is not robust to which seed genes are present\", \"known_failure_modes\": [\"seed-set dependence persists across the two tested seeds (V0 30-gene, V2 68-gene): the 68-gene meta-robust V2 seed gives median Spearman 0.10 under 20%-drop perturbation \\u2014 worse than V0's already-failing 0.65\", \"stronger canonical clock-arm coherence does not transfer to ordering stability: V2 improves trust-check #1 (canonical activator/repressor anti-phase separation +0.45 vs +0.35) while worsening trust-check #3 (the TC#1-up / TC#3-down dissociation). TC#1 covers only the named canonical-clock subset, not all 68 seed genes\", \"flat membership discards per-gene phase/amplitude/evidence weights that the meta-analysis signature carries, so weakly-coherent genes dilute the dominant axis\", \"single-timepoint substrate with no time-of-collection: ordering quality depends on cohort phase coverage and eigenspace conditioning (TCGA luminal-A / Xena-Toil)\"], \"substitutable_with\": []}" ;
        sci:profile "core" ;
        sci:projectStatus "active" ;
        sci:proxyDirectness "indirect" ;
        sci:scope "project" ;
        sci:supportsScope "local_proposition" ;
        sci:triggeredBy <http://example.org/project/dataset/brca-metabric>,
            <http://example.org/project/dataset/brca-tcga-pancanatlas>,
            <http://example.org/project/evidence-line/0013-cmag-wpg-weighted-and-ueda-localize-instability-to-cyclops-autoencoder>,
            <http://example.org/project/evidence-line/0014-cmag-ueda-metabric-stability-recurs-cross-cohort>,
            <http://example.org/project/interpretation/0006-cmag-wpg-weighted-cyclops-vs-clean-room-ueda>,
            <http://example.org/project/interpretation/0007-cmag-ueda-metabric-stability-gate-fail>,
            <http://example.org/project/pre-registration/0002-t046-metabric-cmag-ueda-validation>,
            <http://example.org/project/pre-registration/0003-t046-metabric-cmag-tertile-group-prognosis>,
            <http://example.org/project/source-snapshot/0d90077811312df4>,
            <http://example.org/project/source-snapshot/1da6f651ac57b8bf>,
            <http://example.org/project/source-snapshot/29bb5732b89a9efc>,
            <http://example.org/project/source-snapshot/3badb68e595fbc33>,
            <http://example.org/project/source-snapshot/722314b95c45fc33>,
            <http://example.org/project/source-snapshot/a0a15739f7f40a60>,
            <http://example.org/project/source-snapshot/ae0de6b35e7d759c>,
            <http://example.org/project/source-snapshot/bf78670f1f528804>,
            <http://example.org/project/source-snapshot/c1053c4f14dbdb3b>,
            <http://example.org/project/source-snapshot/c9659605bf87d968>,
            <http://example.org/project/source-snapshot/ed5cab8a8faeebe2> ;
        sci:upstreamChangeAt "2026-07-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
        cito:discusses <http://example.org/project/hypothesis/0001-rhythms-as-homeostatic-control> ;
        cito:extends <http://example.org/project/proposition/0006-cross-sectional-cyclops-cmag-from-a-small-30-gene-seed-is-too-seed> ;
        a sci:Proposition ;
        skos:prefLabel "A larger, more canonical-clock-coherent flat-list seed (V2) does not stabilize CMag ordering on TCGA luminal-A; Phase 2 localizes the residual instability to the CYCLOPS autoencoder (not the seed weights or the substrate)" ;
        skos:related <http://example.org/project/evidence-line/0013-cmag-wpg-weighted-and-ueda-localize-instability-to-cyclops-autoencoder>,
            <http://example.org/project/evidence-line/0014-cmag-ueda-metabric-stability-recurs-cross-cohort>,
            <http://example.org/project/hypothesis/0001-rhythms-as-homeostatic-control>,
            <http://example.org/project/interpretation/0005-cmag-seed-variant-refit-instability-is-method-level>,
            <http://example.org/project/interpretation/0006-cmag-wpg-weighted-cyclops-vs-clean-room-ueda>,
            <http://example.org/project/interpretation/0007-cmag-ueda-metabric-stability-gate-fail>,
            <http://example.org/project/observation/cmag-wpg-weighted-ueda-decision>,
            <http://example.org/project/plan/0009-weighted-cyclops-cmag-phase2-design>,
            <http://example.org/project/pre-registration/0002-t046-metabric-cmag-ueda-validation>,
            <http://example.org/project/proposition/0006-cross-sectional-cyclops-cmag-from-a-small-30-gene-seed-is-too-seed>,
            <http://example.org/project/question/0077-tumor-cmag-prognostic-validation-breast-cancer> ;
        prov:wasDerivedFrom <http://example.org/project/observation/cmag-v2-seed-refit-instability>,

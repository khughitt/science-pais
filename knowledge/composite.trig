            <http://example.org/project/source-snapshot/7e0458cdea3895b9>,
            <http://example.org/project/source-snapshot/ac6ea446536dc29b> ;
        sci:upstreamChangeAt "2026-07-05"^^<http://www.w3.org/2001/XMLSchema#date> ;

        a sci:Observation ;
        skos:prefLabel "Cross-model period sensitivity on the Selgrade/Harris-Clark DDE corroborates the distributed-emergent, no-rate-limiting-node verdict; but the node-weighting is not conserved (DDE is follicular-weighted, GynCycle surge-weighted) and the DDE reproduces \"higher FSH → shorter cycle\"" ;
        skos:related <http://example.org/project/hypothesis/0003-menstrual-cycle-systemic-control>,
            <http://example.org/project/observation/gyncycle-global-sensitivity-distributed>,
            <http://example.org/project/observation/gyncycle-period-sensitivity-distributed>,

        sci:inPatch <http://example.org/project/patch-definition/menopause-pais-causal-dag> ;
        sci:measurementModel "{\"observed_entity\": \"symptom-based / questionnaire case ascertainment of PAIS\", \"latent_construct\": \"the underlying PAIS disease state\", \"measurement_relation\": \"a shared menopause/PAIS symptom repertoire means reproductive stage can bias which individuals are ascertained as cases, in either direction\", \"rationale\": null, \"known_failure_modes\": [\"differential symptom reporting by reproductive stage\", \"mis-attribution of menopausal symptoms to PAIS or vice-versa\", \"case-definition sensitivity\"], \"substitutable_with\": []}" ;
        sci:profile "core" ;
        sci:projectStatus "active" ;
        sci:proxyDirectness "indirect" ;
        sci:scope "project" ;

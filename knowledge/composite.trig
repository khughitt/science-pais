    <http://example.org/project/hypothesis/0001-regulatory-enhancer-setpoints> sci:freshnessState "needs-review" ;
        sci:profile "core" ;
        sci:projectStatus "proposed" ;
        sci:scope "project" ;
        sci:triggeredBy <http://example.org/project/task/t005> ;
        sci:upstreamChangeAt "2026-06-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
        a sci:Hypothesis ;
        skos:prefLabel "Autoimmune susceptibility is primarily encoded in regulatory tuning of immune-cell enhancers (a homeostatic set-point), not in effector-protein coding changes" ;
        skos:related <http://example.org/project/paper/farh2015>,
            <http://example.org/project/topic/immune-homeostasis-and-autoimmunity> ;
        prov:wasDerivedFrom <http://example.org/project/paper/farh2015>,
            <http://example.org/project/source/entities_hypotheses_0001-regulatory-enhancer-setpoints.md> ;
        schema:identifier "hypothesis:0001-regulatory-enhancer-setpoints" .
    <http://example.org/project/hypothesis/0002-trained-immunity-enhancer-convergence> sci:about <http://example.org/project/external/term/GWAS>,
            <http://example.org/project/external/term/NETosis>,
            <http://example.org/project/external/term/enhancers>,
            <http://example.org/project/external/term/epigenetic-reprogramming>,
            <http://example.org/project/external/term/hematopoietic-stem-cell>,
            <http://example.org/project/external/term/immune-homeostasis>,
            <http://example.org/project/external/term/immune-setpoint>,
            <http://example.org/project/external/term/inflammaging>,
            <http://example.org/project/external/term/innate-immune-memory>,
            <http://example.org/project/external/term/trained-immunity> ;
        sci:freshnessState "fresh" ;
        sci:profile "core" ;
        sci:projectStatus "proposed" ;
        sci:scope "project" ;
        a sci:Hypothesis ;
        skos:prefLabel "Innate immune memory (trained immunity) and inherited autoimmune-enhancer risk converge on shared regulatory elements to durably lower the immune activation setpoint" ;
        skos:related <http://example.org/project/hypothesis/0001-regulatory-enhancer-setpoints>,
            <http://example.org/project/topic/immune-homeostasis-and-autoimmunity>,
            <http://example.org/project/topic/innate-memory-and-immune-aging> ;
        prov:wasDerivedFrom <http://example.org/project/source/entities_hypotheses_0002-trained-immunity-enhancer-convergence.md> ;
        schema:identifier "hypothesis:0002-trained-immunity-enhancer-convergence" .
    <http://example.org/project/hypothesis/0003-treg-tsdr-ratchet> sci:about <http://example.org/project/external/term/DNA-methylation>,
            <http://example.org/project/external/term/FOXP3>,
            <http://example.org/project/external/term/IL-6-signaling>,
            <http://example.org/project/external/term/TSDR>,
            <http://example.org/project/external/term/Treg-plasticity>,
            <http://example.org/project/external/term/acute-to-chronic-transition>,
            <http://example.org/project/external/term/epigenetics>,
            <http://example.org/project/external/term/immune-homeostasis>,
            <http://example.org/project/external/term/immune-setpoint>,
            <http://example.org/project/external/term/regulatory-T-cell> ;
        sci:freshnessState "fresh" ;
        sci:profile "core" ;
        sci:projectStatus "proposed" ;
        sci:scope "project" ;

    <http://example.org/project/inquiry-edge/c637437c564fcd5b> sci:backedByClaim <http://example.org/project/proposition/0040-vascular-metabolic-sfn-axes-plausible-effectors> ;
        rdf:object <http://example.org/project/concept/metabolic-mitochondrial-dysfunction> ;

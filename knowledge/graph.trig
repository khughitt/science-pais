    <http://example.org/project/concept/small-fiber-neuropathy-dysautonomia> sci:feedsInto <http://example.org/project/concept/autonomic-dysfunction> .
    <http://example.org/project/concept/thromboinflammation-and-endothelial-dysfunction> sci:feedsInto <http://example.org/project/concept/impaired-o2-delivery-extraction> .
    <http://example.org/project/inquiry-edge/38214084aa5794e7> sci:backedByClaim <http://example.org/project/proposition/0039-immune-state-displacement-mediates-vs-marks-pais-symptoms> ;
        rdf:object <http://example.org/project/concept/pais-outcome> ;
        rdf:predicate sci:feedsInto ;

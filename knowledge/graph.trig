            <http://example.org/project/concept/hormone-therapy> .
    <http://example.org/project/concept/pais-outcome> sci:boundaryRole sci:BoundaryOut ;
        scic:causes <http://example.org/project/concept/clinic-attendance>,
            <http://example.org/project/concept/hospital-ascertainment> .
